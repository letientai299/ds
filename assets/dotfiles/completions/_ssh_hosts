#autoload

local -a hosts config_hosts known_hosts expl queue fields known_files unique_hosts
local config="$HOME/.ssh/config" file line key rest token pattern entry
local -A visited seen_hosts
local index=1 position ret=1

if zstyle -a ":completion:${curcontext}:hosts" hosts hosts; then
  config_hosts=("${hosts[@]}")
else
  position=${words[(I)-F]}
  (( ! position )) || config=${words[position+1]}
  queue=("$config")
  while (( index <= $#queue && index <= 128 )); do
    file=${queue[index]:A}
    (( ++index ))
    [[ -z ${visited[$file]:-} && -f $file && -r $file ]] || continue
    visited[$file]=1
    while IFS= read -r line || [[ -n $line ]]; do
      IFS=$' \t=' read -r key rest <<< "$line"
      case ${key:l} in
        include)
          for token in ${(z)rest}; do
            [[ $token != \#* ]] || break
            pattern=${(Q)token}
            [[ $pattern != '~/'* ]] || pattern="$HOME/${pattern#\~/}"
            [[ $pattern == /* ]] || pattern="$HOME/.ssh/$pattern"
            queue+=(${~pattern}(N))
          done
          ;;
        host)
          for token in ${(z)rest}; do
            [[ $token != \#* ]] || break
            entry=${(Q)token}
            [[ $entry != [\!\#]* && $entry != *[\*\?]* ]] || continue
            config_hosts+=("$entry")
          done
          ;;
      esac
    done < "$file"
  done

  zstyle -a ":completion:${curcontext}:hosts" known-hosts-files known_files ||
    known_files=(/etc/ssh/ssh_known_hosts "$HOME/.ssh/known_hosts")
  for file in "${known_files[@]}"; do
    [[ -f $file && -r $file ]] || continue
    while IFS= read -r line || [[ -n $line ]]; do
      fields=(${(z)line})
      [[ ${fields[1]:-} != @* ]] || fields[1]=()
      [[ -n ${fields[1]:-} ]] || continue
      for entry in ${(s:,:)fields[1]}; do
        [[ -n $entry && $entry != [\|\#\!]* && $entry != *[\*\?]* ]] || continue
        if [[ $entry == \[*\]:<-> ]]; then
          entry=${${entry#\[}%\]:*}
        fi
        [[ $entry != *.* || ${PREFIX:-} == *.* ]] || continue
        known_hosts+=("$entry")
      done
    done < "$file"
  done
fi
unique_hosts=()
for entry in "${config_hosts[@]}"; do
  [[ -z ${seen_hosts[${entry:l}]:-} ]] || continue
  seen_hosts[${entry:l}]=1
  unique_hosts+=("$entry")
done
config_hosts=("${unique_hosts[@]}")
unique_hosts=()
for entry in "${known_hosts[@]}"; do
  [[ -z ${seen_hosts[${entry:l}]:-} ]] || continue
  seen_hosts[${entry:l}]=1
  unique_hosts+=("$entry")
done
known_hosts=("${unique_hosts[@]}")
if (( $#config_hosts )); then
  _wanted hosts expl 'configured SSH host' \
    compadd -J ssh-config -M 'm:{a-zA-Z}={A-Za-z} r:|.=* r:|=*' "$@" -a config_hosts && ret=0
fi
if (( $#known_hosts )); then
  _wanted hosts expl 'known SSH host' \
    compadd -J known-hosts -M 'm:{a-zA-Z}={A-Za-z} r:|.=* r:|=*' "$@" -a known_hosts && ret=0
fi
return $ret
