#!/bin/sh

set -eu

die() {
	printf '%s\n' "ds: $*" >&2
	exit 1
}

script_dir=$(dirname -- "$0")
script_dir=$(CDPATH='' cd "$script_dir" && pwd)
ds_root=${DS_ROOT:-$script_dir}
# A checkout and a delivered snapshot share one layout: `ds` at the root and
# every payload under `src/`.
ds_src=$ds_root/src
os=$(uname -s)
arch=$(uname -m)

if [ "${1:-}" = push ]; then
	[ -x "$ds_src/bundle/controller.sh" ] || die 'push is available only from a controller checkout'
	shift
	exec "$ds_src/bundle/controller.sh" "$@"
fi

if [ -n "${DS_JANET:-}" ]; then
	janet=$DS_JANET
else
	case "$os:$arch" in
	Darwin:arm64) platform=macos-arm64 ;;
	Darwin:x86_64) platform=macos-x64 ;;
	Linux:aarch64 | Linux:arm64) platform=linux-arm64-musl ;;
	Linux:x86_64 | Linux:amd64) platform=linux-x64-musl ;;
	*) die "unsupported platform: $os $arch" ;;
	esac
	janet=$ds_src/runtime/bin/$platform/janet
	if [ ! -x "$janet" ] && [ -x "$ds_root/dist/runtime/bin/$platform/janet" ]; then
		janet=$ds_root/dist/runtime/bin/$platform/janet
	fi
fi

[ -x "$janet" ] || die "pinned Janet runtime is missing: $janet"

export DS_ROOT="$ds_root"
export DS_OS="$os"
export DS_ARCH="$arch"
DS_UID=$(id -u)
export DS_UID
export JANET_PATH="$ds_src"
exec "$janet" "$ds_src/scripts/main.janet" "$@"
