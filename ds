#!/bin/sh
# Checkout launcher: build ds from this checkout with mise's Go and run it
# in the invoking directory.
set -eu

die() {
	printf 'ds: %s\n' "$*" >&2
	exit 1
}

script=$0
while [ -L "$script" ]; do
	dir=$(CDPATH='' cd -P -- "$(dirname -- "$script")" && pwd)
	script=$(readlink -- "$script")
	case "$script" in /*) ;; *) script=$dir/$script ;; esac
done
root=$(CDPATH='' cd -P -- "$(dirname -- "$script")" && pwd)

command -v mise >/dev/null 2>&1 || [ -x "$HOME/.local/bin/mise" ] || die 'mise is required to run a checkout'
mise=$(command -v mise 2>/dev/null || printf '%s' "$HOME/.local/bin/mise")

# One binary per checkout; Go's build cache keeps rebuilds incremental.
key=$(printf '%s' "$root" | cksum | cut -d' ' -f1)
bin=${XDG_CACHE_HOME:-$HOME/.cache}/ds/checkout/ds-$key
# Skip the Go toolchain when no source is newer than the binary.
if [ -x "$bin" ] && [ -z "$(find "$root/cmd" "$root/internal" "$root/go.mod" "$root/go.sum" \
	-newer "$bin" -print 2>/dev/null | head -n 1)" ]; then
	exec "$bin" "$@"
fi
# Running this launcher trusts its checkout; Go installs on first use.
"$mise" trust --quiet "$root" || die "mise trust $root failed"
go=$("$mise" -C "$root" which go 2>/dev/null) || {
	printf 'ds: installing Go for %s\n' "$root" >&2
	"$mise" -C "$root" install go >&2 && go=$("$mise" -C "$root" which go)
} || die "install Go: mise -C $root install go"
env -u GOROOT CGO_ENABLED=0 "$go" build -C "$root" -trimpath -o "$bin" \
	-ldflags "-X 'github.com/letientai299/ds/internal/cli.checkoutRoot=$root'" ./cmd/ds ||
	die "build failed in $root"
exec "$bin" "$@"
