#!/bin/sh

set -eu

die() {
	printf '%s\n' "ds: $*" >&2
	exit 1
}

script_dir=$(dirname -- "$0")
script_dir=$(CDPATH='' cd "$script_dir" && pwd)
df_root=${DF_ROOT:-$script_dir}
os=$(uname -s)
arch=$(uname -m)

if [ "${1:-}" = push ]; then
	[ -x "$df_root/bundle/controller.sh" ] || die 'push is available only from a controller checkout'
	shift
	exec "$df_root/bundle/controller.sh" "$@"
fi

if [ -n "${DF_JANET:-}" ]; then
	janet=$DF_JANET
else
	case "$os:$arch" in
	Darwin:arm64) platform=macos-arm64 ;;
	Darwin:x86_64) platform=macos-x64 ;;
	Linux:aarch64 | Linux:arm64) platform=linux-arm64-musl ;;
	Linux:x86_64 | Linux:amd64) platform=linux-x64-musl ;;
	*) die "unsupported platform: $os $arch" ;;
	esac
	janet=$df_root/runtime/bin/$platform/janet
	if [ ! -x "$janet" ] && [ -x "$df_root/dist/runtime/bin/$platform/janet" ]; then
		janet=$df_root/dist/runtime/bin/$platform/janet
	fi
fi

[ -x "$janet" ] || die "pinned Janet runtime is missing: $janet"

export DF_ROOT="$df_root"
export DF_OS="$os"
export DF_ARCH="$arch"
DF_UID=$(id -u)
export DF_UID
export JANET_PATH="$df_root"
exec "$janet" "$df_root/scripts/main.janet" "$@"
